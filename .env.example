# Copiar para ".env" e preencher com valores reais.
# O ficheiro ".env" NUNCA deve ser commitado (ver .gitignore).

# Chave da API da Resend (https://resend.com) — usada apenas pelas funções serverless em /api.
# Nunca é exposta ao frontend/browser.
RESEND_API_KEY=

# Email do restaurante para onde as notificações de contacto/reserva são enviadas.
RESTAURANT_NOTIFICATION_EMAIL=

# Opcional. Remetente dos emails enviados pela Resend.
# Enquanto não houver domínio próprio verificado na Resend, deixar vazio
# (o código usa "onboarding@resend.dev" por omissão, o domínio de sandbox deles).
RESEND_FROM_EMAIL=
